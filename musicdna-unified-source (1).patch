diff --git a/src/lib/ai/pipeline.ts b/src/lib/ai/pipeline.ts
index 732e604..8ffaab1 100644
--- a/src/lib/ai/pipeline.ts
+++ b/src/lib/ai/pipeline.ts
@@ -161,3 +161,50 @@ export function generateGroundedAnalysis(
 
   return { dna, story, timeline };
 }
+
+/**
+ * Unified analysis (single source of truth).
+ *
+ * Prior to this, `results.tsx` read `analyzeUserJourney(answers)` (archetype /
+ * emotions / recommendedGenres / poster — all answer-dimension-derived) and
+ * `generateGroundedAnalysis(songs)` (era / artist / diversity — all
+ * Song[]-derived) as two independent memos. Nothing wrong was displayed, but
+ * nothing forced them to agree, and the LLM narrative prompt only ever saw the
+ * answer-derived half.
+ *
+ * This function does not replace either engine — the personality dimensions
+ * genuinely come from answers, and Music DNA genuinely comes from songs, and
+ * conflating them would itself be a form of "uydurma". What it does is make
+ * both available from one call, and expose a single `groundedFacts` block
+ * that downstream consumers (UI, LLM prompt) can cite as verified-real,
+ * as distinct from the dimension-derived `profile` guesses (e.g.
+ * `recommendedGenres`, which remain personality-dimension suggestions, not
+ * claims about the actual tracks, until P1 genre enrichment lands).
+ */
+export function buildUnifiedMusicAnalysis(
+  answers: JourneyAnswers | null | undefined,
+  songs: Song[],
+  contexts?: LifeContext[],
+): {
+  profile: PersonalityProfile;
+  dna: ReturnType<typeof generateMusicDNA>;
+  story: GroundedLifeStory;
+  timeline: EmotionalTimeline;
+  isFullyGrounded: boolean;
+} | null {
+  const profile = analyzeUserJourney(answers);
+  if (!profile) return null;
+  if (!songs || songs.length === 0) return null;
+
+  const { dna, story, timeline } = generateGroundedAnalysis(songs, contexts);
+
+  return {
+    profile,
+    dna,
+    story,
+    timeline,
+    // True only when every song is provider-verified AND the DNA engine
+    // itself reports grounded — i.e. nothing in this response is a guess.
+    isFullyGrounded: dna.isGrounded && songs.every((s) => s.verified !== false),
+  };
+}
