# Google OAuth (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_SECRET=      # generate with: openssl rand -base64 32
NEXTAUTH_URL=         # e.g. https://your-app.vercel.app (not needed on Vercel prod, needed locally)

# Gemini (server-side only, never exposed to the browser)
GEMINI_API_KEY=

# Vercel Postgres (auto-filled if you provision it from the Vercel dashboard)
DATABASE_URL=

# Vercel Blob (auto-filled if you provision it from the Vercel dashboard)
BLOB_READ_WRITE_TOKEN=
