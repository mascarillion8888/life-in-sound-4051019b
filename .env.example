# Life in a Sound — frontend env (public, safe for browser — RLS enforced).
# Copy to .env and fill from your Supabase project (Project Settings → API).
# The service-role key must NEVER be placed here or used client-side.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini API (client-reachable Gemini features). Optional — leave blank to
# keep Gemini-powered features disabled. Read via import.meta.env.VITE_GEMINI_API_KEY.
VITE_GEMINI_API_KEY=

# Hugging Face Inference token (BROWSER-reachable; VITE_-prefixed so Vite
# exposes it to the client — used ONLY by the client-side GothicArt helper
# src/services/huggingFaceService.ts). This must be an intentionally PUBLIC /
# anon HF inference token: it ships to the browser. For the SERVER-side card
# artwork tier use HUGGINGFACE_API_KEY below instead (never VITE_-prefixed).
# Optional — leave blank if you only use the server-side HF/Gemini tiers.
VITE_HF_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# SERVER-ONLY VARIABLES — never VITE_-prefixed, never shipped to the
# browser. Set thes in the server runtime env (shell / deploy settings), not
# in the browser bundle. Placeholders only — fill with your real keys locally.
# ═══════════════════════════════════════════════════════════════════
#
# Gemini — powers the poetic Music Map analyzer
#(src/lib/llm/generateAnalysis.server.ts) ANDthe Era Card fine-art paintings
#(src/lib/art/cardArtwork.server.ts). Without it,the analyzer silently falls
# back to the deterministic engine,and cards show the dark gothic placeholder
# instead of a generated painting.
GEMINI_API_KEY=your_gemini_api_key_here
#
# Optional override for the Imagen model used for card paintings
#(default: imagen-3.0-generate-002; Gemini native image generation is the
# automatic fallback path).
GEMINI_IMAGE_MODEL=your_image_model_here
#
# Hugging Face Inference (server-only, NO VITE_). Third tier of the Era Card
# artwork chain (after Imagen + Gemini native image) — with ONLY this key
# set, card paintings are generated via HF text-to-image. Model override:
#(default: stabilityai/stable-diffusion-3-medium-diffusers — must be in the
# live hf-inference catalog; SDXL base / FLUX schnell were deprecated with HTTP 410).
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HF_IMAGE_MODEL=your_huggingface_image_model_here
#
# Groq — powers the Orchestra `summarizer` role:the Life Story narrative AND
#the Era Card poetic lore snippets (src/lib/art/generateCard.server.ts). Without
#it, lore falls back to the deterministic track-seeded snippet — never empty.
GROQ_API_KEY=your_groq_api_key_here
#
# Spotify Web API — powers the live song suggestion dropdown via
# spotifySuggestSongs. Without these, suggestions fall back to the iTunes path.
